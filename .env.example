# Copie para .env.local (fica fora do Git) e rode `npm run build`.
# As variáveis VITE_ entram no JavaScript público do site: não coloque segredo aqui.

# Id do Pixel da Meta (só números). Vazio = Pixel desligado.
VITE_META_PIXEL_ID=

# Endereço que recebe o formulário. Vazio = https://www.ariuno.com.br/api/leads/site
VITE_FORM_ENDPOINT=
